{
  "name": "linktreev1",
  "version": "1.3.1",
  "type": "module",
  "description": "Página pessoal de links do Victor Cardoso — animações baseadas em física, UI com efeito vidro (glassmorphism), pronto para PWA.",
  "main": "script.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,html,css,json,md}\"",
    "check": "tsc --noEmit && prettier --check \"**/*.{js,ts,html,css,json,md}\"",
    "test": "vitest run"
  },
  "keywords": [
    "portfolio",
    "linktree",
    "gsap",
    "vite",
    "glassmorphism"
  ],
  "author": "Victor Cardoso <victorcardcunha@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "gsap": "3.14.2",
    "lenis": "1.3.17",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.8.1",
    "typescript": "5.8.2",
    "vite": "7.3.6",
    "vite-plugin-handlebars": "2.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
